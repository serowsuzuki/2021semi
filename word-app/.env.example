# Anthropic API(単語情報の自動生成に使用。サーバー側でのみ利用しフロントには渡さない)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル(省略時: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# 生成時のeffort。low / medium / high / xhigh / max(省略時: medium)
# ANTHROPIC_EFFORT=medium

# APIサーバーのポート(省略時: 3001)
# PORT=3001

# SQLiteファイルの場所(省略時: server/data/words.db)
# DB_PATH=./server/data/words.db

# 復習日の基準タイムゾーン(省略時: サーバーのローカルTZ)
TZ=Asia/Tokyo
